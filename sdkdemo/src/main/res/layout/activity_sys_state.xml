<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".SysStatusActivity">

    <TextView
        android:id="@+id/tv_sys_event_log"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#E1E1E1"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Button
        android:id="@+id/btn_register_power_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:onClick="receiveSysEvent"
        android:text="Battery Events" />

    <Button
        android:id="@+id/btn_unregister_power_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:onClick="receiveSysEvent"
        android:text="Unsub Battery" />

    <Button
        android:id="@+id/btn_power_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:onClick="receiveSysEvent"
        android:text="Get Battery"/>
    <Button
        android:id="@+id/btn_is_charging"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:onClick="receiveSysEvent"
        android:text="Is Charging?"/>

</LinearLayout>
    <TextView
        android:id="@+id/tv_sys_status_log"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#E1E1E1"/>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <Button
        android:id="@+id/btn_register_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="receiveSysEvent"
        android:layout_margin="10dp"
        android:text="Robot Status"/>
     <Button
        android:id="@+id/btn_publish_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="receiveSysEvent"
         android:layout_margin="10dp"
        android:text="Publish Sleep"/>

        <Button
            android:id="@+id/btn_unregister_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="receiveSysEvent"
             android:layout_margin="10dp"
            android:text="Unsubscribe"/>
</LinearLayout>

</LinearLayout>
