<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActionActivity">

    <Button
        android:id="@+id/btn_action_taiji"
        android:layout_margin="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Tai Chi"
        android:onClick="actionTaiji"/>

    <Button
        android:id="@+id/btn_action_hand"
        android:layout_margin="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/btn_action_taiji"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Hands Up"
        android:onClick="actionHandUp"/>

    <Button
        android:id="@+id/btn_action_sit_down"
        android:layout_margin="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/btn_action_hand"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Squat"
        android:onClick="actionSquat"/>

    <Button
        android:id="@+id/btn_action_standup"
        android:layout_margin="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/btn_action_sit_down"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Stand Up"
        android:onClick="actionStandup"/>

    <EditText
        android:id="@+id/et_action_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_action_taiji"
        app:layout_constraintStart_toStartOf="parent"
        android:hint="Enter action name (e.g. 010)"/>

    <Button
        android:id="@+id/btn_action_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/et_action_name"
        android:layout_marginLeft="20dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/et_action_name"
        android:onClick="actionDone"
        android:text="Run"/>

    <EditText
        android:id="@+id/et_customize_action_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/et_action_name"
        app:layout_constraintStart_toStartOf="parent"
        android:hint="Custom action (path: sdcard/customize/actions)"/>

    <Button
        android:id="@+id/btn_customize_action_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/et_customize_action_name"
        android:layout_marginLeft="20dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/et_customize_action_name"
        android:onClick="customizeActionDone"
        android:text="Run"/>

    <Button
        android:id="@+id/btn_action_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:onClick="actionStop"
        android:text="Stop Action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_customize_action_name"

       />

    <Button
        android:id="@+id/btn_action_resect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:onClick="actionResect"
        android:text="Reset"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toRightOf="@+id/btn_action_stop"
        app:layout_constraintTop_toBottomOf="@+id/et_customize_action_name"
     />

    <ScrollView
        android:id="@+id/sv_action_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_action_stop"
      >
     <TextView
         android:id="@+id/tv_action_log"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:minHeight="100dp"
         android:paddingLeft="10dp"
         android:paddingRight="10dp"
         android:background="#E1E1E1"/>
    </ScrollView>
    <Button
        android:id="@+id/btn_action_list"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="10dp"
        android:onClick="actionList"
        android:text="Get Action List"/>
</androidx.constraintlayout.widget.ConstraintLayout>
